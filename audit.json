  "findings": [],
  "recommendations": [
    {
      "title": "Extend structured data to Product/Offer nodes",
      "detail": "Organization schema is present but individual products and prices are not modelled. Adding Product with an Offer (price, priceCurrency, availability) lets assistants quote your pricing with attribution instead of paraphrasing a table.",
      "category": "structured_data",
      "effort": "medium"
    },
    {
      "title": "Add lastmod dates to the published sitemap",
      "detail": "A sitemap is published (230 URLs across 6 sitemap documents) but carries no <lastmod> values, so crawlers cannot tell which pages changed and re-fetch on a blind schedule instead of a freshness signal.",
      "category": "crawlability",
      "effort": "low"
    },
    {
      "title": "Add Organization schema alongside the existing structured data",
      "detail": "Structured data is present (FAQPage, Question, WebPage) but no Organization/LocalBusiness node was found. Organization markup is what ties products, reviews and articles to a single citable entity.",
      "category": "structured_data",
      "effort": "low"
    },
    {
      "title": "Validate structured data in CI so a syntax error cannot ship",
      "detail": "The site already relies on JSON-LD, so a single malformed block silently removes every machine-readable fact on that page. Add a schema validation step to the build (a JSON parse plus a schema.org type check) to keep the markup trustworthy.",
      "category": "structured_data",
      "effort": "low"
    },
    {
      "title": "Add FAQPage schema for the questions buyers actually ask",
      "detail": "FAQ structured data is the cheapest way to get exact question/answer pairs into AI answers, and it reuses copy you already have on product and support pages.",
      "category": "structured_data",
      "effort": "low"
    },
    {
      "title": "Add breadcrumb navigation with BreadcrumbList markup",
      "detail": "No breadcrumbs were found. Breadcrumbs give a visitor arriving from an AI citation immediate context about where they are, and give crawlers an explicit hierarchy for the site.",
      "category": "engagement",
      "effort": "low"
    },
    {
      "title": "Make internal anchor text descriptive",
      "detail": "372 internal links use generic anchor text (e.g. \"Learn more\"). Descriptive anchors such as 'AcmeKube pricing' tell both readers and models what the destination covers. This is a refinement, not a defect: the links themselves work.",
      "category": "engagement",
      "effort": "low"
    },
    {
      "title": "Add `sameAs` links to social profiles in Organization JSON-LD",
      "detail": "Even if your site is otherwise healthy, adding `sameAs` links to your LinkedIn, Crunchbase, and Twitter profiles inside your Organization JSON-LD explicitly binds those distinct sources together into one entity graph. AI assistants heavily rely on this to merge facts from different domains into a single confident answer.",
      "category": "entity_identity",
      "effort": "low"
    }
  ],
