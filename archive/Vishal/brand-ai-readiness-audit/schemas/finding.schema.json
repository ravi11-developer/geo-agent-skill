{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["id", "title", "severity", "evidence", "suggested_action"],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low"]
    },
    "evidence": {
      "type": "string"
    },
    "suggested_action": {
      "type": "object",
      "required": ["summary", "priority"],
      "properties": {
        "summary": { "type": "string" },
        "priority": { "type": "string", "enum": ["critical", "high", "medium", "low"] }
      }
    }
  }
}
