{
  "id": "ai-discoverability-engagement-marketplace",
  "name": "AI Discoverability & Engagement Audit Marketplace",
  "version": "1.0.0",
  "description": "Manifest-driven read-only audits for AI discoverability, retrieval, rendering, extraction, entity resolution, freshness, trust, and navigation.",
  "license": "MIT",
  "entrypoint": "audit-orchestrator",
  "contracts": {
    "categories": [
      "crawlability",
      "rendering",
      "content_extraction",
      "structured_data",
      "non_text_facts",
      "freshness",
      "entity_identity",
      "engagement"
    ]
  },
  "safety": {
    "read_only": true,
    "http_methods": ["GET"],
    "max_pages_per_run": 12,
    "max_runtime_seconds": 60
  },
  "skills": [
    {
      "id": "audit-orchestrator",
      "name": "Audit Orchestrator",
      "version": "1.0.0",
      "kind": "orchestrator",
      "path": "skills/audit-orchestrator",
      "entrypoint": "scripts/orchestrate.py",
      "provides": [],
      "consumes": [],
      "produces": ["audit_report"],
      "enabled": true
    },
    {
      "id": "crawl-render-audit",
      "name": "Crawl & Render Audit",
      "version": "1.0.0",
      "kind": "audit",
      "path": "skills/crawl-render-audit",
      "entrypoint": "scripts/crawl_render.py",
      "provides": ["crawlability", "rendering"],
      "consumes": [],
      "produces": ["snapshot"],
      "enabled": true
    },
    {
      "id": "content-semantics-audit",
      "name": "Content & Semantics Audit",
      "version": "1.0.0",
      "kind": "audit",
      "path": "skills/content-semantics-audit",
      "entrypoint": "scripts/content_semantics.py",
      "provides": ["content_extraction", "structured_data", "non_text_facts"],
      "consumes": ["snapshot"],
      "produces": ["fact_coverage"],
      "enabled": true
    },
    {
      "id": "entity-freshness-audit",
      "name": "Entity & Freshness Audit",
      "version": "1.0.0",
      "kind": "audit",
      "path": "skills/entity-freshness-audit",
      "entrypoint": "scripts/entity_freshness.py",
      "provides": ["entity_identity", "freshness"],
      "consumes": ["snapshot"],
      "produces": ["entity_profile", "corroboration"],
      "enabled": true
    },
    {
      "id": "engagement-audit",
      "name": "Engagement & Orientation Audit",
      "version": "1.0.0",
      "kind": "audit",
      "path": "skills/engagement-audit",
      "entrypoint": "scripts/engagement.py",
      "provides": ["engagement"],
      "consumes": ["snapshot"],
      "produces": ["navigation_profile"],
      "enabled": true
    }
  ]
}
