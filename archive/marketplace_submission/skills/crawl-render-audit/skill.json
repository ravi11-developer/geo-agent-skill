{
  "id": "crawl-render-audit",
  "name": "Crawl & Render Audit",
  "version": "1.0.0",
  "kind": "audit",
  "entrypoint": "scripts/crawl_render.py",
  "function": "run(context: dict) -> SkillResult",
  "provides": [
    "crawlability",
    "rendering"
  ],
  "consumes": [],
  "produces": [
    "snapshot"
  ],
  "detectors": {
    "crawlability": [
      "entry_url_not_200",
      "robots_disallow_for_ai_agents",
      "noindex_meta_or_header"
    ],
    "rendering": [
      "empty_element_filled_by_inline_js",
      "empty_framework_root",
      "noscript_gate_with_thin_text"
    ]
  },
  "severity_model": {
    "crawlability": "critical|high",
    "rendering": "high"
  },
  "safety": {
    "read_only": true,
    "http_methods": [
      "GET"
    ],
    "respects_robots_txt": true,
    "max_pages": 12,
    "timeout_seconds": 8
  },
  "skill_md": "SKILL.md",
  "references": [
    "detection-rules.md",
    "false-positive-log.md"
  ]
}
