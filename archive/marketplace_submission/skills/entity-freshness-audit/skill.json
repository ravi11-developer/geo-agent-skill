{
  "id": "entity-freshness-audit",
  "name": "Entity & Freshness Audit",
  "version": "1.0.0",
  "kind": "audit",
  "entrypoint": "scripts/entity_freshness.py",
  "function": "run(context: dict) -> SkillResult",
  "provides": [
    "entity_identity",
    "freshness"
  ],
  "consumes": [
    "snapshot"
  ],
  "produces": [
    "entity_profile",
    "corroboration"
  ],
  "identity_slots": [
    "title",
    "h1",
    "json-ld Organization name/legalName/alternateName",
    "og:title",
    "og:site_name",
    "footer copyright",
    "body 'Welcome to'",
    "'About' heading",
    "body 'formerly'",
    "body 'division of'"
  ],
  "detectors": {
    "entity_identity": [
      ">=3 distinct normalised names",
      ">=1 near-variant pair with similarity in [0.50, 0.95)"
    ],
    "freshness": [
      "copyright_year <= current_year - 2",
      ">=3 stale dated claims with no current-era year"
    ],
    "external_corroboration_advice": [
      "zero sameAs/citation/review schema keys",
      "zero links to identity platforms",
      "zero cite/rel=author elements",
      "site has a canonical name and >=120 words",
      "emitted as an entity_identity recommendation, never a finding"
    ]
  },
  "severity_model": {
    "entity_identity": "high",
    "freshness": "high (>=8 stale claims) | medium"
  },
  "safety": {
    "read_only": true,
    "network": "none"
  },
  "skill_md": "SKILL.md",
  "references": [
    "detection-rules.md",
    "entity-resolution.md"
  ]
}
